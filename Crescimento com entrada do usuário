import java.util.Scanner;

public class Exercicio5 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        char repetir;

        do {
            int popA, popB;
            double taxaA, taxaB;

            do {
                System.out.print("População do país A: ");
                popA = sc.nextInt();
                System.out.print("Taxa de crescimento A (%): ");
                taxaA = sc.nextDouble();
                System.out.print("População do país B: ");
                popB = sc.nextInt();
                System.out.print("Taxa de crescimento B (%): ");
                taxaB = sc.nextDouble();

                if (popA >= popB || taxaA <= taxaB) {
                    System.out.println("Valores inválidos. A deve ter população menor e taxa maior que B.");
                }
            } while (popA >= popB || taxaA <= taxaB);

            int anos = 0;
            while (popA <= popB) {
                popA += (int)(popA * (taxaA / 100));
                popB += (int)(popB * (taxaB / 100));
                anos++;
            }

            System.out.println("Levará " + anos + " anos para A ultrapassar B.");

            System.out.print("Deseja repetir? (s/n): ");
            repetir = sc.next().toLowerCase().charAt(0);
        } while (repetir == 's');
    }
}
